# =============================================================================
# MAXWELL FRONTEND ENV TEMPLATE
# Copy to `.env.local` for local development.
# =============================================================================

# Core auth/UI mode
NEXT_PUBLIC_USE_WORKSPACE_AUTH=true
# Min time (ms) tab must stay hidden untuk before session refresh on return (default 120000 = 2 min). Gallery/file flows stay smooth.
# NEXT_PUBLIC_SESSION_RESUME_MIN_TAB_MS=120000
NEXT_PUBLIC_APP_ADMIN_EMAILS=panparci@gmail.com

# API base
# Dev (same-origin rewrite): http://localhost:3000/fe
# Direct Nest local:          http://localhost:3002/fe
# Google OAuth: in Google Cloud Console, authorized redirect URI must match Nest, e.g.asd
#   http://localhost:3000/fe/auth/google/callback  (when using Next dev rewrite to :3002)
# Production:                 https://server-maxwell-production.up.railway.app/fe
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/fe

# Domain routing (default API)
NEXT_PUBLIC_EXTERNAL_API_ONLY=true
NEXT_PUBLIC_MEMBERS_BACKEND=API
NEXT_PUBLIC_EVENTS_BACKEND=API
NEXT_PUBLIC_OPS_BACKEND=API
NEXT_PUBLIC_PRODUCTS_BACKEND=API
NEXT_PUBLIC_ENTITLEMENTS_BACKEND=API
NEXT_PUBLIC_INVITATIONS_BACKEND=API
NEXT_PUBLIC_COMMUNICATION_BACKEND=API
NEXT_PUBLIC_PAYMENTS_BACKEND=API
NEXT_PUBLIC_SUPPORT_BACKEND=API
# Executive Cockpit → Nest GET `/fe/dashboard/executive` (members + payment_transactions)
NEXT_PUBLIC_DASHBOARD_BACKEND=API

# Payment flags
# PPN/VAT is per-product (`ppnRatePercent` on products + checkout from API). This env is unused by checkout UI; safe to omit or leave 0.
# NEXT_PUBLIC_PAYMENT_PPN_RATE_PERCENT=0
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
# true = no Midtrans Snap: in-app success modal + backend simulate-settle (same PAID path as webhook).
# Local / Vercel testing: keep true. Real Midtrans in production: set false and configure server webhook + keys.
# If this preview build calls a production API host, that API must allow simulate-settle (see server ALLOW_PAYMENT_SIMULATION).
NEXT_PUBLIC_MIDTRANS_UI_DISABLED=true

# Optional Supabase client vars (only needed for browser-side Supabase features)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

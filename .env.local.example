# Optional overrides (see `.env.development` for default local API in dev)
# To hit Railway while running `next dev`: set both:
# NEXT_PUBLIC_USE_PRODUCTION_API=true
# NEXT_PUBLIC_API_BASE_URL=https://server-maxwell-production.up.railway.app/fe
NEXT_PUBLIC_EVENTS_BACKEND=API
NEXT_PUBLIC_OPS_BACKEND=API

# Payments pricing
# PPN/VAT rate (percent) used by FE for display purposes.
NEXT_PUBLIC_PAYMENT_PPN_RATE_PERCENT=0

# Midtrans
# If backend uses MIDTRANS_IS_PRODUCTION=false, FE must load sandbox snap.js.
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
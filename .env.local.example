# Copy ke `.env.local`. Secrets & DB hanya di `server-maxwell/.env` (Nest + Prisma).

# `false` memaksa mock OTP lama.
NEXT_PUBLIC_USE_WORKSPACE_AUTH=true

NEXT_PUBLIC_APP_ADMIN_EMAILS=you@example.com

# Dev: same-origin rewrite (next.config) `/fe` → Nest di 3002.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/fe

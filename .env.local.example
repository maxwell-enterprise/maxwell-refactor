# Copy to `.env.local`. One door: set `NEXT_PUBLIC_API_BASE_URL` to your Nest `/fe` base (see `.env.development`).
# Unset per-domain vars default to Nest `API`. Override only when needed, e.g.:
# NEXT_PUBLIC_MEMBERS_BACKEND=SUPABASE
# System sidebar (Automations, Security, Database, AI Usage, Maintenance) → Nest `/fe/system/*`:
# NEXT_PUBLIC_SYSTEM_BACKEND=API

# EP from BE (production Railway; lokal: http://localhost:3002/fe)
NEXT_PUBLIC_API_BASE_URL=https://server-maxwell-production.up.railway.app/fe
NEXT_PUBLIC_EVENTS_BACKEND=API
NEXT_PUBLIC_INVITATIONS_BACKEND=API
NEXT_PUBLIC_COMMUNICATION_BACKEND=API
NEXT_PUBLIC_OPS_BACKEND=API
NEXT_PUBLIC_SUPPORT_BACKEND=API

NEXT_PUBLIC_PAYMENT_PPN_RATE_PERCENT=0

# Midtrans
# If backend uses MIDTRANS_IS_PRODUCTION=false, FE must load sandbox snap.js.
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

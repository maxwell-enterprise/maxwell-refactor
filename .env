# Supabase (optional — AUTH / CMS / WA when keys set). Data domains default to Nest via `NEXT_PUBLIC_API_BASE_URL`.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API base: dev loads `.env.development`; production uses `.env.production` / Vercel.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/fe

# EP from BE (Nest global prefix /fe → …/fe/events, …/fe/health)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/fe
NEXT_PUBLIC_API_BASE_URL=https://server-maxwell-production.up.railway.app/fe
NEXT_PUBLIC_EXTERNAL_API_ONLY=true
NEXT_PUBLIC_MEMBERS_BACKEND=API
NEXT_PUBLIC_EVENTS_BACKEND=API
NEXT_PUBLIC_OPS_BACKEND=API
NEXT_PUBLIC_PRODUCTS_BACKEND=API
NEXT_PUBLIC_ENTITLEMENTS_BACKEND=API
NEXT_PUBLIC_INVITATIONS_BACKEND=API
NEXT_PUBLIC_COMMUNICATION_BACKEND=API
NEXT_PUBLIC_PAYMENTS_BACKEND=API
NEXT_PUBLIC_SUPPORT_BACKEND=API
NEXT_PUBLIC_PAYMENT_PPN_RATE_PERCENT=0

# Midtrans
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
